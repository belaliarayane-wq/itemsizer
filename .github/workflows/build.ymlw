name: Build Mod
on: [push, workflow_dispatch]
jobs:
  build:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: ItemSizer-Fabric-1.21.1/ItemSizerMod
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'
      - name: Build Mod JAR
        run: gradle build
      - uses: actions/upload-artifact@v4
        with:
          name: ItemSizer-Mod-JAR
          path: ItemSizer-Fabric-1.21.1/ItemSizerMod/build/libs/itemsizer-1.0.0.jar
